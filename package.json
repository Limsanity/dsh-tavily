{
  "name": "@lim324/dsh-tavily",
  "version": "0.3.1",
  "type": "module",
  "description": "Tavily web search for DSH: settings toggle back to official DeepSeek, keyless by default",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SZMY-haruhi/dsh-tavily.git"
  },
  "bugs": {
    "url": "https://github.com/SZMY-haruhi/dsh-tavily/issues"
  },
  "homepage": "https://github.com/SZMY-haruhi/dsh-tavily#readme",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "web-search",
    "tavily"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-api-settings-controller"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-web": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-web-search-deepseek": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-launch-environment": "^0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-credentials": "0.1.5-rc.1",
    "@deepseek-ai/dsh-launch-environment": "0.1.5-rc.1",
    "@deepseek-ai/dsh-web": "0.1.5-rc.1",
    "@deepseek-ai/dsh-web-search-deepseek": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-store": "0.1.5-rc.1",
    "@deepseek-ai/dsh-base": "0.1.5-rc.1",
    "@deepseek-ai/dsh-web-app": "0.1.5-rc.1"
  }
}
